# Copiar a .env y reemplazar los marcadores antes de arrancar.
LOCAL_API_STATION=estacion-dev
LOCAL_API_JWT_KEY=<clave-local-aleatoria>
LOCAL_API_DEVICES='{"dispositivo-dev":{"station":"estacion-dev","secret_hash":"<hash-scrypt>","operations":["ListarTiposVehiculo"]}}'
# Dejar vacÃ­o para levantar Swagger sin conectar a SQL Server.
LOCAL_API_SQL_CONNECTION=
LOCAL_API_TOKEN_SECONDS=300
LOCAL_API_SQL_TIMEOUT=5
